# Copy to .env and fill in. Never commit the real .env.

# Required.
DATABASE_URL=postgres://user:password@127.0.0.1:5432/gjs
# At least 32 characters. Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=

# Email for payment and exam-fee reminders. Optional: leave EMAIL_PROVIDER unset and the app
# still records every reminder in the notification centre, it just does not post any of them.
# brevo = send through the Brevo API. console = write to the server log, for local testing.
EMAIL_PROVIDER=console
BREVO_API_KEY=
# Must be a sender address verified in Brevo, or Brevo rejects the message.
EMAIL_FROM=
EMAIL_FROM_NAME=GSC Gemmological School

# The daily reminder sweep. Two ways to run it; use one.
#
# 1. From inside the app, once each morning. Right for a single machine with no scheduler.
REMINDER_JOB_IN_PROCESS=0
#
# 2. From an outside scheduler (Windows Task Scheduler, cron). At least 16 characters:
#      curl -X POST -H "authorization: Bearer <secret>" http://localhost:3001/api/jobs/reminders
#    Leave this blank and the route is closed to everyone.
REMINDER_JOB_SECRET=
